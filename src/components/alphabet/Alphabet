import React from 'react';
import type { HebrewLetter } from '../../types';
import type { LetterNikudVariant } from '../../data/letterNikud';
import { useGameTimer } from '../../hooks/useGameTimer';
import { useSoundEffects } from '../../hooks/useSoundEffects';
import styles from './AlphabetMemoryGame.module.css';

type LetterCard = {
  id: string;
  pairId: string;
  label: string;
  isHebrew: boolean;
  matched: boolean;
  letterKey: string; // base letter char for stats/tracking
};

type LetterResult = {
  correct: number;
  wrong: number;
};

function shuffle<T>(arr: T[]): T[] {
  return [...arr].sort(() => Math.random() - 0.5);
}

function buildDeck(letters: HebrewLetter[], variants: LetterNikudVariant[], pairCount: number): LetterCard[] {
  const base = shuffle(letters).slice(0, Math.min(pairCount, letters.length));
  const cards: LetterCard[] = [];
  base.forEach((l) => {
    const availableVariants = variants.filter((v) => v.baseLetter === l.letter);
    const hebrewLabel = availableVariants.length > 0
      ? shuffle(availableVariants)[0].nikudChar // show letter with a nikud mark
      : l.letter;
    cards.push({
      id: `${l.letter}-char-${hebrewLabel}`,
      pairId: l.letter,
      label: hebrewLabel,
      isHebrew: true,
      matched: false,
      letterKey: l.letter,
    });
    cards.push({
      id: `${l.letter}-name`,
      pairId: l.letter,
      label: l.name,
      isHebrew: false,
      matched: false,
      letterKey: l.letter,
    });
  });
  return shuffle(cards);
}

interface AlphabetMemoryGameProps {
  letters: HebrewLetter[];
  variants?: LetterNikudVariant[]; // nikud-enhanced letter cards
  onEvent?: (isMatch: boolean) => void;
  onLetterResult?: (letterKey: string, isCorrect: boolean) => void;
}

type Phase = 'setup' | 'play' | 'flash' | 'done';
const PAIR_OPTIONS = [2, 3, 4, 5, 6, 7, 8, 10, 12];
const TURN_OPTIONS = [8, 12, 16, 20, 25, 30, 40, 50];

const AlphabetMemoryGame: React.FC<AlphabetMemoryGameProps> = ({ letters, variants, onEvent, onLetterResult }) => {
  const maxPairs = Math.min(12, letters.length);
  const { playClick, playMatch } = useSoundEffects();
  const [phase, setPhase] = React.useState<Phase>('setup');
  const [pairCount, setPairCount] = React.useState(Math.min(6, maxPairs));
  const [turnLimit, setTurnLimit] = React.useState(20);
  const [deck, setDeck] = React.useState<LetterCard[]>([]);
  const [open, setOpen] = React.useState<number[]>([]);
  const [moves, setMoves] = React.useState(0);
  const [countdown, setCountdown] = React.useState(4);
  const [exploding, setExploding] = React.useState<Set<string>>(new Set());
  const [totalTime, setTotalTime] = React.useState(0);
  const [results, setResults] = React.useState<Record<string, LetterResult>>({});
  const [turnExceeded, setTurnExceeded] = React.useState(false);

  const { seconds, formattedTime, resetTimer } = useGameTimer(phase === 'play' || phase === 'flash');

  const totalPairs = Math.min(pairCount, letters.length);

  const startGame = () => {
    setDeck(buildDeck(letters, variants ?? [], pairCount));
    setOpen([]);
    setMoves(0);
    setCountdown(4);
    setExploding(new Set());
    setResults({});
    setTurnExceeded(false);
    resetTimer();
    setPhase('play');
  };

  // 5s play -> 1s flash loop
  React.useEffect(() => {
    if (phase === 'play') {
      if (countdown <= 0) {
        setPhase('flash');
        setCountdown(2);
        return;
      }
      const t = setTimeout(() => setCountdown((c) => c - 1), 1000);
      return () => clearTimeout(t);
    } else if (phase === 'flash') {
      if (countdown <= 0) {
        setPhase('play');
        setCountdown(4);
        return;
      }
      const t = setTimeout(() => setCountdown((c) => c - 1), 1000);
      return () => clearTimeout(t);
    }
  }, [phase, countdown]);

  const finishGame = React.useCallback(
    (exceeded: boolean) => {
      setTotalTime(seconds);
      setTurnExceeded(exceeded);
      setPhase('done');
    },
    [seconds],
  );

  // Auto-finish when the turn limit is reached
  React.useEffect(() => {
    if (phase === 'play' && moves >= turnLimit) {
      finishGame(true);
    }
  }, [phase, moves, turnLimit, finishGame]);

  const onPick = (idx: number) => {
    if (phase !== 'play') return;
    if (open.length === 2) return;
    if (deck[idx].matched || open.includes(idx)) return;

    playClick();

    const next = [...open, idx];
    setOpen(next);

    if (next.length === 2) {
      setMoves((m) => m + 1);
      const [a, b] = next;
      const isMatch = deck[a].pairId === deck[b].pairId;
      const letterKey = deck[a].letterKey;
      onEvent?.(isMatch);

      // Per-letter stats
      setResults((prev) => {
        const prevResult = prev[letterKey] ?? { correct: 0, wrong: 0 };
        return {
          ...prev,
          [letterKey]: {
            correct: prevResult.correct + (isMatch ? 1 : 0),
            wrong: prevResult.wrong + (isMatch ? 0 : 1),
          },
        };
      });
      onLetterResult?.(letterKey, isMatch);

      if (isMatch) {
        playMatch();
        const ids = new Set([deck[a].id, deck[b].id]);
        setExploding(ids);
        setDeck((prev) => prev.map((c, i) => (i === a || i === b ? { ...c, matched: true } : c)));
        setOpen([]);
        setTimeout(() => {
          setExploding(new Set());
          setDeck((prev) => {
            if (prev.every((c) => c.matched)) {
              finishGame(false);
            }
            return prev;
          });
        }, 580);
      } else {
        setTimeout(() => setOpen([]), 750);
      }
    }
  };

  if (phase === 'setup') {
    const pairOpts = PAIR_OPTIONS.filter((n) => n <= maxPairs);
    return (
      <div className={styles.wrap}>
        <h3 className={styles.setupTitle}>🧠 Memory — выбери настройки</h3>
        <div className={styles.setupSection}>
          <div className={styles.setupLabel}>Количество пар:</div>
          <div className={styles.pairOptions}>
            {pairOpts.map((n) => (
              <button
                key={n}
                className={`${styles.pairBtn} ${pairCount === n ? styles.pairBtnActive : ''}`}
                onClick={() => setPairCount(n)}
              >
                <span className={styles.pairBtnNum}>{n}</span>
                <span className={styles.pairBtnSub}>{n * 2} карт</span>
              </button>
            ))}
          </div>
        </div>
        <div className={styles.setupSection}>
          <div className={styles.setupLabel}>Лимит ходов (turns):</div>
          <div className={styles.pairOptions}>
            {TURN_OPTIONS.map((n) => (
              <button
                key={n}
                className={`${styles.pairBtn} ${turnLimit === n ? styles.pairBtnActive : ''}`}
                onClick={() => setTurnLimit(n)}
              >
                <span className={styles.pairBtnNum}>{n}</span>
                <span className={styles.pairBtnSub}>{n} ходов</span>
              </button>
            ))}
          </div>
        </div>
        {variants && variants.length > 0 && (
          <p className={styles.setupHint}>🔤 Буквы показываются с огласовками (никуд)</p>
        )}
        <button className={styles.startBtn} onClick={startGame}>Начать →</button>
      </div>
    );
  }

  // ── RESULTS with per-letter stats ─────────────────────────
  if (phase === 'done') {
    const perfectLetters = Object.values(results).filter((r) => r.correct > 0 && r.wrong === 0).length;
    const slowLetters = Object.values(results).filter((r) => r.wrong > 0).length;
    const letterKeys = Object.keys(results);
    return (
      <div className={styles.wrap}>
        <div className={styles.topRow}>
          <span>🧠 Результаты</span>
        </div>
        <h3 className={styles.resultsTitle}>
          {turnExceeded ? '⏰ Лимит ходов!' : '🎉 Все пары найдены!'}
        </h3>
        <div className={styles.resultsSummary}>
          <span className={styles.resStat}>✅ {perfectLetters}</span>
          <span className={styles.resStat}>🔁 {slowLetters} с ошибками</span>
          <span className={styles.resStat}>⏱ {totalTime}s</span>
          <span className={styles.resStat}>Ходы: {moves}</span>
        </div>

        {letterKeys.length > 0 ? (
          <div className={styles.resultsList}>
            {letterKeys.map((key) => {
              const r = results[key];
              const foundLetter = letters.find((l) => l.letter === key);
              const ok = r.correct > 0 && r.wrong === 0;
              return (
                <div key={key} className={`${styles.resultRow} ${ok ? styles.resultOk : styles.resultFail}`}>
                  <span className={styles.resHebrew}>{foundLetter?.letter ?? key}</span>
                  <div className={styles.resInfo}>
                    <span className={styles.resName}>{foundLetter?.name ?? key}</span>
                  </div>
                  <span className={styles.resStats}>✅{r.correct} ❌{r.wrong}</span>
                </div>
              );
            })}
          </div>
        ) : (
          <p className={styles.resultsEmpty}>Нет данных по буквам.</p>
        )}

        <button className={styles.restart} onClick={() => setPhase('setup')}>Ещё раз</button>
      </div>
    );
  }

  // ── GAME ───────────────────────────────────────────────────
  return (
    <div className={styles.wrap}>
      <div className={styles.topRow}>
        <span>🧠 Memory</span>
        <div className={styles.timerRow}>
          {phase === 'flash' ? (
            <span className={styles.flashText}>Смотри!</span>
          ) : (
            <span className={styles.countdown}>Подсказка через: {countdown}</span>
          )}
        </div>
        <div className={styles.statsRight}>
          <span className={styles.gameTimer}>⏱ {formattedTime}</span>
          <span>Ходы: {moves}/{turnLimit}</span>
          <span>Пары: {totalPairs}/{totalPairs}</span>
        </div>
      </div>

      <div className={styles.grid}>
        {deck.map((card, idx) => {
          const isForceOpen = phase === 'flash';
          const isOpen = isForceOpen || open.includes(idx);
          const isBursting = exploding.has(card.id);
          if (card.matched && !isBursting) {
            return <div key={card.id} className={styles.cardGone} />;
          }
          return (
            <button
              key={card.id}
              className={`${styles.card} ${isOpen ? styles.open : ''} ${isBursting ? styles.exploding : ''} ${card.isHebrew && isOpen ? styles.hebrewCard : ''}`}
              onClick={() => onPick(idx)}
            >
              {isOpen || isBursting ? card.label : '❓'}
            </button>
          );
        })}
      </div>
    </div>
  );
};

export default AlphabetMemoryGame;